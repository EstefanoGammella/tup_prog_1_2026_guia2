Proceso Triangulo
	definir l1,l2,l3 como real;
	Escribir "Ingresar la medida de cada segmento";
	Leer l1,l2,l3;
	Si (l1+l2>l3)y(l1+l3>l2)y(l2+l3>l1) Entonces
		Escribir "Los segmentos pueden formar un triangulo";
	SiNo
		Escribir "los segmentos no pueden formar un triangulo";
	FinSi
FinProceso
