Proceso MayorValor
	Definir a, b Como Real;
	Escribir 'Ingrese 5 valores:';
	Leer a;
	Leer b;
	Si b>a Entonces
		a <- b;
	FinSi
	Leer b;
	Si b>a Entonces
		a <- b;
	FinSi
	Leer b;
	Si b>a Entonces
		a <- b;
	FinSi
	Leer b;
	Si b>a Entonces
		a <- b;
	FinSi
	Escribir 'El mayor valor ingresado es: ', a;
FinProceso
